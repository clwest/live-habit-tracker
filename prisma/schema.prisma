// Live Habit Tracker — data model
// Three entities: User, Habit, HabitEntry
// - A User owns many Habits
// - A Habit has many HabitEntries (one per day it's marked done)
// - UNIQUE(habitId, date) prevents double-marking the same day

generator client {
  // Using legacy prisma-client-js generator (default node_modules/.prisma/client
  // output) — Next.js outputFileTracing handles the engine binary copy
  // automatically. The new 'prisma-client' generator with a custom src/
  // output path works locally but Next doesn't trace the binary into the
  // Vercel function bundle, causing PrismaClientInitializationError at runtime.
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for serverless runtime (Next.js on Vercel).
  url       = env("DATABASE_URL")
  // Direct connection for migrations (bypasses PgBouncer).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits Habit[]
}

enum Cadence {
  DAILY
  WEEKLY
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  title     String
  cadence   Cadence  @default(DAILY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@index([userId])
}

model HabitEntry {
  id      String   @id @default(cuid())
  habitId String
  date    DateTime @db.Date
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}
