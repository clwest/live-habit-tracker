// Live Habit Tracker — data model
// Three entities: User, Habit, HabitEntry
// - A User owns many Habits
// - A Habit has many HabitEntries (one per day it's marked done)
// - UNIQUE(habitId, date) prevents double-marking the same day

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits Habit[]
}

enum Cadence {
  DAILY
  WEEKLY
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  title     String
  cadence   Cadence  @default(DAILY)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@index([userId])
}

model HabitEntry {
  id      String   @id @default(cuid())
  habitId String
  date    DateTime @db.Date
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}
